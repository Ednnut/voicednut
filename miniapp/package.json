{
  "name": "miniapp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "homepage": "https://voicednut-miniapp.vercel.app",
  "scripts": {
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "dev:fixtures": "cross-env VITE_ADMIN_DASHBOARD_DEV_FIXTURES=1 vite",
    "dev:https": "cross-env HTTPS=true vite",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test e2e/dashboard.spec.ts",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
    "validate:contracts": "tsc -p tsconfig.contracts.json && node .tmp-contract-check/scripts/validate-miniapp-contracts.js",
    "validate:prod": "npm run validate:contracts && npm run lint && npm run build",
    "preview": "vite preview",
    "predeploy": "npm run build"
  },
  "dependencies": {
    "@telegram-apps/telegram-ui": "^2.1.9",
    "@tma.js/sdk-react": "^3.0.8",
    "@tonconnect/ui-react": "^2.2.0",
    "@vapi-ai/web": "^3.0.1",
    "eruda": "^3.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.23.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.11",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.34.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "terser": "^5.44.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^6.3.5",
    "vite-plugin-mkcert": "^1.17.8",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@swc/core@1.15.18": true
  }
}
