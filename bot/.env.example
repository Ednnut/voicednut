# --- Telegram Bot Environment -----------------------
ADMIN_TELEGRAM_ID=
ADMIN_TELEGRAM_USERNAME=
BOT_TOKEN=

# API the bot should call (point to /api server)
API_URL=http://127.0.0.1:1337
TEMPLATES_API_URL=http://127.0.0.1:1337

# Shared API credential (must match API_SECRET in api/.env)
API_SECRET=change-me

# Dedicated CALL-E actor binding secret; must match CALL_E_ACTOR_ASSERTION_SECRET on the API.
CALL_E_ACTOR_ASSERTION_SECRET=

# Mini App launch URL (Vercel production URL recommended)
MINI_APP_URL=https://voxly-miniapp.vercel.app

# Optional defaults
DEFAULT_VOICE_MODEL=aura-asteria-en
DEFAULT_BUSINESS_ID=general
DEFAULT_CALL_PURPOSE=general
BOT_EPHEMERAL_TTL_MS=8000
