# Copy to api/.env. For Speko, SPEKO_API_KEY and SPEKO_WEBHOOK_SECRET are required.
# SERVER is the public HTTPS hostname used to construct provider callbacks (for example api.example.com).
CALL_PROVIDER=speko
SMS_PROVIDER=twilio
EMAIL_PROVIDER=sendgrid

# API
API_SECRET=replace-with-a-random-secret
PORT=3000
SERVER=
CORS_ORIGINS=

# Speko voice calls
SPEKO_ENABLED=true
SPEKO_EXCLUSIVE_MODE=true
SPEKO_AGENT_RELEASE_GATE_REQUIRED=true
SPEKO_API_KEY=
# Optional backward-compatible default agent. Normally selected per call in Telegram.
SPEKO_AGENT_ID=
SPEKO_WEBHOOK_SECRET=
SPEKO_BASE_URL=https://api.speko.dev
SPEKO_AGENT_VERSION=
SPEKO_MONTHLY_SPEND_LIMIT_USD=0
SPEKO_LOW_BALANCE_ALERT_USD=0
SPEKO_RECONCILE_INTERVAL_MS=120000
SPEKO_RECONCILE_STALE_MINUTES=5

# Optional Speko features; keep disabled until explicitly configured.
SPEKO_INBOUND_ENABLED=false
# Required only when SPEKO_INBOUND_ENABLED=true.
SPEKO_INBOUND_PHONE_NUMBER=
# JSON map keyed by E.164 destination number; required for enabled inbound routing. Optional speko_agent_id per route.
INBOUND_NUMBER_ROUTES={}
SPEKO_CALL_CONTROL_ENABLED=false
SPEKO_AGENT_TOOLS_ENABLED=false

# Optional Twilio SMS. Set these if SMS_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
FROM_NUMBER=

# AI services used by voice workflows
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=

# Optional email and Telegram integrations
SENDGRID_API_KEY=
EMAIL_DEFAULT_FROM=
TELEGRAM_BOT_TOKEN=

# Advanced provider, Mini App, payment, CRM, and runtime settings:
# see api/.env.advanced.example
