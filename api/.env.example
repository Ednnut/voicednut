# Minimal local API setup. Provider credentials are optional until you enable
# or use that integration.
NODE_ENV=development
PORT=1337

# Generate a unique value with: openssl rand -hex 32
# Replace this placeholder before starting the API.
API_SECRET=replace-with-a-unique-secret

# Telegram user IDs allowed to administer API-side Cartesia operations.
TELEGRAM_ADMIN_USER_IDS=

# Allow the local Mini App dev server to call the API.
CORS_ORIGINS=http://localhost:5173
