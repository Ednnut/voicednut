# --- API Environment (Minimal) ----------------------------------------------
# Keep this file lean. Advanced tuning knobs live in `.env.advanced.example`.

# Providers
CALL_PROVIDER=twilio
CALL_PROVIDER_ORDER=twilio,plivo,vonage
PROVIDER_FAILOVER_ENABLED=true
SMS_PROVIDER=twilio
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
EMAIL_DEFAULT_FROM=
EMAIL_VERIFIED_DOMAINS=
CRM_PROVIDER=stub
CRM_REQUEST_TIMEOUT_MS=15000

# Native CRM sync credentials (optional; set CRM_PROVIDER to enable)
HUBSPOT_API_KEY=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_CONTACTS_TABLE=Contacts
AIRTABLE_ACTIVITIES_TABLE=Activities
GOHIGHLEVEL_API_KEY=
GOHIGHLEVEL_LOCATION_ID=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_INSTANCE_URL=

# Security
API_SECRET=change-me
# Optional API HMAC replay controls
# API_HMAC_REPLAY_VALIDATION=warn
# API_HMAC_REPLAY_WINDOW_MS=300000

# Server
PORT=3000
SERVER=
CORS_ORIGINS=

# --- Twilio (required when CALL_PROVIDER=twilio) ----------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
FROM_NUMBER=

# --- Plivo (required when CALL_PROVIDER=plivo or SMS_PROVIDER=plivo) --------
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_VOICE_FROM_NUMBER=
PLIVO_SMS_FROM_NUMBER=
PLIVO_ANSWER_URL=
PLIVO_EVENT_URL=
PLIVO_WEBHOOK_SECRET=
PLIVO_WEBHOOK_VALIDATION=strict

# --- Vonage (required when CALL_PROVIDER=vonage) ----------------------------
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
VONAGE_VOICE_FROM_NUMBER=
VONAGE_SMS_FROM_NUMBER=

# --- AI Runtime ---------------------------------------------------------------
# Cartesia Managed Agents (server-side only; dispatch is disabled by default)
CARTESIA_ENABLED=false
CARTESIA_DISPATCH_ENABLED=false
CARTESIA_AGENT_RUNTIME_ENABLED=false
CARTESIA_API_KEY=
CARTESIA_ADMIN_API_KEY=
CARTESIA_APPROVAL_SECRET=
# Used only for Managed Agent lifecycle webhooks; configure a secret of at least 32 characters.
CARTESIA_WEBHOOK_SECRET=
# Public HTTPS callback URL ending in /webhook/cartesia.
CARTESIA_WEBHOOK_URL=
# Leave at the default unless Cartesia provisions a dedicated Enterprise regional endpoint.
CARTESIA_API_BASE_URL=https://api.cartesia.ai
CARTESIA_API_TIMEOUT_MS=12000

# Vapi server-side integration (disabled unless explicitly enabled)
VAPI_ENABLED=false
VAPI_PRIVATE_API_KEY=
VAPI_API_TIMEOUT_MS=10000
# Comma-separated exact origins permitted to load synced Vapi assistants in the Mini App.
VAPI_WEB_ALLOWED_ORIGINS=
# Optional event ingestion. Configure a matching Bearer Token custom credential in Vapi.
VAPI_WEBHOOK_URL=
VAPI_WEBHOOK_CREDENTIAL_ID=
VAPI_WEBHOOK_BEARER_TOKEN=
# CALL-E server integration (disabled by default; never expose the key to clients)
CALLE_ENABLED=false
CALLE_DISPATCH_ENABLED=false
CALLE_API_KEY=
# Dedicated BOT-to-API actor binding secret. Generate a random 32+ character value and set the same value in bot/.env.
CALL_E_ACTOR_ASSERTION_SECRET=
# Exact E.164 destinations allowed by the server-side CALL-E outbound service; empty means none.
CALLE_ALLOWED_DESTINATIONS=
# Use https://test-api.heycall-e.com only with a test-compatible key.
CALLE_BASE_URL=https://api.heycall-e.com
CALLE_API_TIMEOUT_MS=10000
# Optional fixed public HTTPS receiver URL; omit query parameters, credentials, and fragments.
CALLE_WEBHOOK_URL=
# Set only for an approved, single exact preview; all three values are required.
CALLE_PILOT_APPROVED_FINGERPRINT=
CALLE_PILOT_APPROVAL_REFERENCE=
CALLE_PILOT_APPROVAL_EXPIRES_AT=
CALLE_PILOT_READINESS_REVIEWED=false
# Versioned server-side keys for encrypted CALL-E mission destinations. Keep old versions until their missions are terminal.
CALLE_MISSION_ENCRYPTION_KEYS=
CALLE_MISSION_ENCRYPTION_KEY_VERSION=1
CALLE_MISSION_DISPATCH_ENABLED=false
CALLE_MISSION_WORKER_ENABLED=false
CALLE_MISSION_WORKER_BUSINESS_ID=
CALLE_MISSION_WORKER_ACTOR_ID=
CALLE_MISSION_WORKER_ID=voicednut-call-e-mission-worker-1
CALLE_MISSION_WORKER_INTERVAL_MS=60000
CALLE_GOAL_RUN_DISPATCH_ENABLED=false
CALLE_SENSITIVE_DATA_RETENTION_DAYS=90
CALLE_DATA_RETENTION_WORKER_ENABLED=false
CALLE_DATA_RETENTION_WORKER_INTERVAL_MS=3600000
CALLE_OPS_ALERTS_WORKER_ENABLED=false
CALLE_OPS_ALERTS_WORKER_INTERVAL_MS=60000
CALLE_MISSION_AUTOMATION_WORKER_ENABLED=false
CALLE_MISSION_AUTOMATION_WORKER_INTERVAL_MS=60000
# Both the mission ID and matching request fingerprint are required for one mission's exact dispatch approval.
CALLE_MISSION_APPROVED_ID=
CALLE_MISSION_APPROVED_FINGERPRINT=
CALLE_MISSION_APPROVAL_REFERENCE=
CALLE_MISSION_APPROVAL_EXPIRES_AT=
CALLE_MISSION_MAX_RECIPIENTS=0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
VOICE_MODEL=aura-2-andromeda-en

# Optional Cartesia speech services (Deepgram remains the default for both)
STT_PROVIDER=deepgram
TTS_PROVIDER=deepgram
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_API_VERSION=2026-08-14
CARTESIA_TTS_TIMEOUT_MS=10000
CARTESIA_TTS_FALLBACK_TO_DEEPGRAM=true
# Hosted Cartesia agent over the server-side WebSocket (requires script selection).
# Cartesia retains call audio/transcripts by default; review handling and applicable consent before enabling.
CARTESIA_LINE_AGENT_ENABLED=false
CARTESIA_LINE_DATA_HANDLING_REVIEWED=false
# Cartesia Managed Agents (disabled until explicitly enabled)
CARTESIA_MANAGED_AGENTS_ENABLED=false
CARTESIA_MANAGED_AGENTS_TIMEOUT_MS=10000
CARTESIA_DISPATCH_ENABLED=false
CARTESIA_BATCH_DISPATCH_ENABLED=false
# Poll locally stored, non-terminal batches with bounded, restart-safe GET requests.
CARTESIA_BATCH_RECONCILIATION_ENABLED=false
CARTESIA_BATCH_RECONCILIATION_INTERVAL_MS=60000
CARTESIA_BATCH_RECONCILIATION_BATCH_SIZE=5
# Batch recipient deletion stays disabled until an operator sets a retention policy.
CARTESIA_BATCH_RETENTION_ENABLED=false
CARTESIA_BATCH_RETENTION_DAYS=0
CARTESIA_PHONE_NUMBER_MUTATIONS_ENABLED=false
CARTESIA_PHONE_NUMBER_PROVISIONING_ENABLED=false
CARTESIA_SIP_PROVIDER_MUTATIONS_ENABLED=false
CARTESIA_TELEPHONY_PROVIDER_MUTATIONS_ENABLED=false
CARTESIA_WEBHOOK_MUTATIONS_ENABLED=false
CARTESIA_ALLOWED_DESTINATIONS=
CARTESIA_WEBHOOK_SECRET=

# Voice runtime mode
# legacy | hybrid | voice_agent
VOICE_RUNTIME_MODE=legacy
VOICE_AGENT_SECONDARY_ENABLED=false
POST_CALL_WORKFLOWS_ENABLED=false

# --- Telegram fallback (optional) --------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Payment connectors (optional) -------------------------------------------
# Full PayPal/Stripe tuning options live in `.env.advanced.example`.
CONNECTOR_PAYMENT_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Telegram Mini App (Vercel deployment) -----------------------------------
# Set MINI_APP_URL to your deployed frontend URL and include it in CORS_ORIGINS.
MINI_APP_URL=https://voxly-miniapp.vercel.app
MINI_APP_SESSION_SECRET=
MINI_APP_SESSION_TTL_SECONDS=900
MINI_APP_INITDATA_MAX_AGE_SECONDS=86400
MINI_APP_INITDATA_EXPIRY_GRACE_SECONDS=604800
MINI_APP_REPLAY_WINDOW_SECONDS=600
# Replay validation mode: warn (default) | strict | off
MINI_APP_REPLAY_VALIDATION=warn

# --- Common optional defaults -------------------------------------------------
DEFAULT_SMS_BUSINESS_ID=
CONFIG_COMPLIANCE_MODE=safe
RECORDING_ENABLED=false

# --- Where are advanced options? ---------------------------------------------
# Copy any needed overrides from:
#   api/.env.advanced.example
